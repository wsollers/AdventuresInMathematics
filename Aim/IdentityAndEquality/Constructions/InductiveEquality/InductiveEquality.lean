/-!
# Inductive Equality

Equality generated by reflexivity, mirroring Lean's identity type.
-/

namespace Aim.IdentityAndEquality.Constructions.InductiveEquality

universe u

/-- Equality as an inductive proposition with reflexivity as its constructor. -/
inductive MetaEq {X : Sort u} : X → X → Prop
  | refl (x : X) : MetaEq x x

end Aim.IdentityAndEquality.Constructions.InductiveEquality
